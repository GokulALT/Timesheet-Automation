# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001                         # optional  (default: 3001)

# ── AI schedule generation ──────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...          # REQUIRED  — get from build.nvidia.com
AI_MODEL=z-ai/glm-5.3-flash      # optional  (default: z-ai/glm-5.3-flash)

# ── Kimai / myTime API ──────────────────────────────────────────────────────
# These are fallbacks only; credentials entered in the browser UI take precedence.
# KIMAI_BASE_URL=https://timesheet.lntedutech.com/api
# KIMAI_USER=you@lntedutech.com
# KIMAI_TOKEN=your-api-password

# ── Legacy Ollama (not used by default) ─────────────────────────────────────
# OLLAMA_MODEL=llama3
# OLLAMA_HOST=http://127.0.0.1:11434
